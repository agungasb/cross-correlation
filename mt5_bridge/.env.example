# MT5 Execution Bridge Environment Configuration
# Mode: "live" (Windows VPS with MT5 Terminal) or "mock" (Local dev on macOS / Linux)
MT5_MODE=mock

# MT5 Account Credentials (Required for "live" mode)
MT5_LOGIN=12345678
MT5_PASSWORD=your_demo_password
MT5_SERVER=ICMarketsSC-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Risk & Execution Defaults
MT5_MAGIC_NUMBER=883921
MT5_DEFAULT_SLIPPAGE_POINTS=30
MT5_MAX_SPREAD_POINTS=50

# Server & Security
MT5_BRIDGE_HOST=0.0.0.0
MT5_BRIDGE_PORT=8000
MT5_BRIDGE_AUTH_TOKEN=your_secure_shared_secret_token_here

# Broker Symbol Normalization (e.g., if broker adds a suffix like .ecn, .m, or uses GOLD)
# Format: JSON dictionary mapping standard symbol to broker symbol
MT5_SYMBOL_MAP={"XAUUSD": "XAUUSD", "EURUSD": "EURUSD"}
